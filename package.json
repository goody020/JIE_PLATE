{
  "name": "fernami-next",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/check-node.cjs",
    "dev": "next dev --webpack --hostname localhost",
    "build": "next build --webpack",
    "start": "next start --hostname localhost",
    "lint": "biome lint src scripts next.config.ts",
    "format": "biome format --write src scripts next.config.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "playwright test",
    "test:persistence": "node scripts/persistence-check.cjs",
    "prebuild": "node scripts/check-node.cjs",
    "prestart": "node scripts/check-node.cjs",
    "test:security": "node scripts/security-check.cjs",
    "dev:turbo": "next dev --turbopack --hostname localhost",
    "build:turbo": "next build --turbopack"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.13",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24"
  }
}
