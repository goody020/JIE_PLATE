# Default: a working local GUEST test-order demo, not fake local authentication.
ORDER_STORAGE=local
# DATA_DIR=./data

# Your existing Supabase setup (keep your actual values in .env.local):
# ORDER_STORAGE=supabase
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_ONLY_KEY
# A legacy service-role key may use SUPABASE_SERVICE_ROLE_KEY instead.
# The base URL must NOT include /rest/v1, a table path or query parameters.

# v0.4 customer authentication: a DIFFERENT key from the same project.
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
# Do not replace the server secret with this value. Both keys serve different roles.
# Auth calls run through our Next.js server with HttpOnly cookies, so neither key
# needs a NEXT_PUBLIC_ prefix in this implementation.

# Apply the account ownership SQL migration and configure the email template.
# See AUTH-SETUP.md. No project, user account, SMTP or payment is pre-connected.
NEXT_TELEMETRY_DISABLED=1
