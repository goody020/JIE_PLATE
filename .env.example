# Default: local guest test-order demo.
ORDER_STORAGE=local
# DATA_DIR=./data

# Supabase server configuration.
# Keep real values only in .env.local or Vercel environment variables.
# ORDER_STORAGE=supabase
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_ONLY_KEY
# A legacy service-role key may use SUPABASE_SERVICE_ROLE_KEY instead.

# Customer authentication key from the same Supabase project.
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY

# Paystack production payments.
# Never put the real live key in this file.
# PAYSTACK_SECRET_KEY=sk_live_YOUR_PAYSTACK_SECRET_KEY

# Production URL used for Paystack callbacks.
# NEXT_PUBLIC_SITE_URL=https://jie-plate-git-main-goody020s-projects.vercel.app

NEXT_TELEMETRY_DISABLED=1
SHIPBUBBLE_API_KEY=your_shipbubble_live_api_key